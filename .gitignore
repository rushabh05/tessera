# data tiers are regenerated by `just data`, never committed
data/raw/
data/interim/
data/processed/
*.parquet
*.zip

# results are append-only artifacts; keep JSON, drop bulky checkpoints
*.ckpt
*.pt
*.onnx
results/**/checkpoints/

# secrets: the CryptoPAn key and user-id salt MUST NEVER be tracked.
# tests/test_no_secrets_tracked.py fails the build if these appear.
secrets/
*.key
.env

# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# os / editor
.DS_Store
.idea/
.vscode/
