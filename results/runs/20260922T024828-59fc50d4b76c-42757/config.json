{
  "dataset": {
    "name": "fixture",
    "builder": "tessera.data.synthetic.make_fixture",
    "is_synthetic": true,
    "params": {}
  },
  "model": {
    "name": "random",
    "builder": "tessera.models.baselines.dummy.build",
    "params": {}
  },
  "split": {
    "name": "r2_grouped",
    "regime": "R2",
    "enforce_groups": [
      "session_id"
    ],
    "params": {
      "val_frac": 0.2,
      "test_frac": 0.2,
      "gap_seconds": 600
    }
  },
  "seed": 0,
  "deterministic": true,
  "eval": {
    "threshold": 0.5,
    "windows_per_day": 1440,
    "base_rates": [
      0.01,
      0.001,
      0.0001
    ]
  },
  "leakage": {
    "run_permutation": true,
    "e1_required_drop_ap": 0.02
  }
}